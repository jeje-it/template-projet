{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "agent": {
    "main": {
      "description": "Primary coding agent"
    },
    "build": {
      "disable": false
    },
    "plan": {
      "disable": false
    }
  },
  "username": "",
  "provider": {
    "openai": {
      "models": {
        "gpt-5": {
          "options": {
            "reasoningEffort": "high",
            "textVerbosity": "low",
            "reasoningSummary": "auto"
          }
        },
        "gpt-4o": {
          "options": {
            "textVerbosity": "low"
          }
        }
      }
    },
    "anthropic": {
      "models": {
        "claude-sonnet-4-20250514": {
          "options": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 8000
            }
          }
        },
        "claude-opus-4-20250514": {
          "options": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 16000
            }
          }
        }
      }
    },
    "google-vertex": {
      "options": {
        "project": "",
        "location": "global"
      },
      "models": {
        "gemini-2.5-pro": {
          "name": "Gemini 2.5 Pro"
        }
      }
    },
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio",
      "options": {
        "baseURL": "http://localhost:1234/v1"
      },
      "models": {
        "qwen/qwen3.6-35b-a3b": {
          "name": "Qwen3.6 35B A3B"
        },
        "qwen/qwen3-coder-30b": {
          "name": "Qwen3 Coder 30B"
        }
      }
    }
  },
  "permission": {
    "bash": {
      "*": "allow",
      "gcloud *": "ask",
      "*DB_TARGET=production*": "ask",
      "*NODE_ENV=production*": "ask"
    }
  },
  "mcp": {}
}
